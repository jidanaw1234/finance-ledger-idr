{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": false,
    "typeRoots": ["./backend/node_modules/@types"]
  },
  "exclude": ["node_modules", "backend/dist", "frontend/dist"]
}
